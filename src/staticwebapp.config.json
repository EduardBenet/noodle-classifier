{
  "routes": [
    {
      "route": "/sw.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/add",
      "allowedRoles": [
        "owner"
      ]
    },
    {
      "route": "/add.html",
      "allowedRoles": [
        "owner"
      ]
    },
    {
      "route": "/queue",
      "allowedRoles": [
        "owner"
      ]
    },
    {
      "route": "/queue.html",
      "allowedRoles": [
        "owner"
      ]
    },
    {
      "route": "/mylist",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/mylist.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/submit",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/submit.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/suggest-edit",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/suggest-edit.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/profile",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/profile.html",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/signin.html",
      "statusCode": 302
    }
  },
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
