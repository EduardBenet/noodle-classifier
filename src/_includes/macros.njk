{# Shared markup fragments. Imported as:  {% import "macros.njk" as ui %}

   The score pickers were written out three times (add, submit, overlay) and
   differ only in the radio group name. That mattered because the fill effect is
   pure CSS — `input:checked ~ label` over a 5→1 reversed list — so each copy was
   an independent chance to break the sibling order silently. Ids are derived
   from the group name, which is what every existing copy already did. #}

{% macro spicePicker(name, label) %}
<div class="spice-row">
    <label>{{ label }}</label>
    <div class="spice-picker">
        {# 0 is a real level — not spicy at all — so it needs its own control,
           and it sits outside .spice-chilies so it highlights no chillies. #}
        <input type="radio" name="{{ name }}" id="{{ name }}0" value="0" class="spice-none-input">
        <label for="{{ name }}0" class="spice-none" title="Not spicy at all">None</label>
        <div class="spice-chilies">
            {% for i in [5, 4, 3, 2, 1] %}
            <input type="radio" name="{{ name }}" id="{{ name }}{{ i }}" value="{{ i }}"><label for="{{ name }}{{ i }}">🌶️</label>
            {% endfor %}
        </div>
    </div>
</div>
{% endmacro %}

{% macro ratingPicker(name, label) %}
<div class="rating-row">
    <label>{{ label }}</label>
    <div class="rating-stars">
        {% for i in [5, 4, 3, 2, 1] %}
        <input type="radio" name="{{ name }}" id="{{ name }}{{ i }}" value="{{ i }}"><label for="{{ name }}{{ i }}">★</label>
        {% endfor %}
    </div>
</div>
{% endmacro %}

{# Provider icons. Only the path data was duplicated between the header menu and
   signin.html — the surrounding link markup genuinely differs between the two,
   so it stays where it is. #}

